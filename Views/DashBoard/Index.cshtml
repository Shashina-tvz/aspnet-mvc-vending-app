@{
    ViewData["Title"] = "Dashboard";
    Layout = "../Shared/_Layout.cshtml";
}

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }
    
    .card {
        background: #23272f;
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
        border: 1px solid #2e323a;
    }

    .card h2 {
        margin: 0;
        color: #4fc3f7;
    }

    .dashboard-card {
        transition: all 0.25s ease;
        cursor: pointer;
    }

    .dashboard-card:hover {
        background: #2e323a;
        transform: translateY(-4px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.25);
        border-color: #3a3f4b;
    }

    .dashboard-card h2 {
        transition: color 0.2s ease;
    }

    .dashboard-card:hover h2 {
        color: #66d9ff;
    }

    .quick-links {
        margin-top: 2rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .link-card {
        background: #2e323a;
        padding: 1rem 1.5rem;
        border-radius: 10px;
        color: #fff;
        text-decoration: none;
    }

    .link-card:hover {
        background: #3a3f4b;
    }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <span>Home</span>
    </div>
</div>

<h1>Dashboard Overview</h1>

<div class="grid">
    <div class="card dashboard-card" onclick="location.href='@Url.Action("Index", "Product")'" style="cursor: pointer;">
        <h2>@ViewBag.ProductCount</h2>
        <p>Products</p>
    </div>

    <div class="card dashboard-card" onclick="location.href='/Supplier'" style="cursor: pointer;">
        <h2>@ViewBag.SupplierCount</h2>
        <p>Suppliers</p>
    </div>

    <div class="card dashboard-card" onclick="location.href='/VendingMachine'" style="cursor: pointer;">
        <h2>@ViewBag.MachineCount</h2>
        <p>Machines</p>
    </div>

    <div class="card dashboard-card" onclick="location.href='/Order'" style="cursor: pointer;">
        <h2>@ViewBag.OrderCount</h2>
        <p>Orders</p>
    </div>

    <div class="card dashboard-card" onclick="location.href='/MaintenanceLog'" style="cursor: pointer;">
        <h2>@ViewBag.MaintenanceCount</h2>
        <p>Maintenance</p>
    </div>

    <div class="card dashboard-card" onclick="location.href='/Technician'" style="cursor: pointer;">
        <h2>@ViewBag.TechCount</h2>
        <p>Technicians</p>
    </div>
</div>

