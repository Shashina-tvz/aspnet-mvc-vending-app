@model IEnumerable<VendingMachineApp.Data.Entities.Order>

@using System.Globalization

<style>
    .plain-link {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        transition: opacity 0.2s;
    }
    .plain-link:hover {
        opacity: 0.7;
        text-decoration: underline dotted;
    }
</style>

<table>
    <thead>
        <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Supplier</th>
            <th>Status</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var order in Model)
    {
        <tr id="order-@order.OrderId">

            <!-- ORDER ID -->
            <td>
                <a href="/Order/Details/@order.OrderId" class="plain-link">
                    #@order.OrderId
                </a>
            </td>

            <!-- DATE -->
            <td>
                @order.OrderDate.ToString("dd.MM.yyyy")
            </td>

            <!-- SUPPLIER -->
            <td>
                @if (order.Supplier != null)
                {
                    <a href="/Supplier/Details/@order.Supplier.SupplierId" class="plain-link">
                        @order.Supplier.Name
                    </a>
                }
            </td>

            <!-- STATUS -->
            <td>
                <span class="category-badge">
                    @order.Status
                </span>
            </td>

            <!-- TOTAL -->
            <td>
                <span class="price-badge">
                    @order.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("de-DE"))
                </span>
            </td>

            <!-- ACTIONS -->
            <td class="actions">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="/Order/Details/@order.OrderId" class="btn-icon view">
                            <i class="fa-solid fa-eye"></i>
                        </a>
                    }
                   
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a href="/Order/Edit/@order.OrderId" class="btn-icon edit">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                    }
                    
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Order/Delete/@order.OrderId" class="btn-icon delete">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                     }
            </td>

        </tr>
    }
    </tbody>
</table>