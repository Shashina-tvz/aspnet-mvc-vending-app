@using VendingMachineApp.Data.Repositories

@inject ProductRepository productRepo
@inject SupplierRepository supplierRepo
@inject VendingMachineRepository machineRepo
@inject OrderRepository orderRepo
@inject MaintenanceLogRepository logRepo
@inject TechnicianRepository techRepo
@{
    var products = (await productRepo.GetAllAsync()).ToList();
    var suppliers = (await supplierRepo.GetAllAsync()).ToList();
    var machines = (await machineRepo.GetAllAsync()).ToList();
    var orders = (await orderRepo.GetAllAsync()).ToList();
    var logs = (await logRepo.GetAllAsync()).ToList();
    var technicians = (await techRepo.GetAllAsync()).ToList();
}


<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - VendingMachineApp</title>

```

<style>
    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #1b1e24;
        color: #f3f3f3;
        display: flex;
    }

    /* SIDEBAR */
    .sidebar {
        width: 240px;
        background: #23272f;
        height: 100vh;
        padding: 1.5rem;
        box-sizing: border-box;
        position: fixed;
    }

    .sidebar h2 {
        color: #4fc3f7;
        margin-bottom: 2rem;
    }

    .nav-link {
        display: block;
        color: #f3f3f3;
        text-decoration: none;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: 0.2s;
    }

    .nav-link:hover {
        background: #2e323a;
    }

    /* CONTENT */
    .content {
        margin-left: 240px;
        padding: 2rem;
        width: 100%;
    }

    /* FLYOUT MENU */
    .nav-item {
        position: relative;
    }

    .flyout {
        position: absolute;
        left: 100%;
        top: 0;

        background: #23272f;
        border-radius: 10px;
        padding: 10px;

        display: none;
        flex-direction: column;

        min-width: 220px;
        max-height: 300px;
        overflow-y: auto;

        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .flyout a {
        color: #b0b3b8;
        text-decoration: none;
        padding: 8px 10px;
        border-radius: 6px;
    }

    .flyout a:hover {
        background: #2e323a;
        color: white;
    }

    .nav-item:hover .flyout {
        display: flex;
    }

    /* SCROLLBAR */
    .flyout::-webkit-scrollbar {
        width: 6px;
    }

    .flyout::-webkit-scrollbar-thumb {
        background: #4fc3f7;
        border-radius: 10px;
    }

    /* BREADCRUMB */

    .breadcrumb-container {
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #2e323a;
    padding-bottom: 0.5rem;
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.9rem;
    }

    /* LINK kao mini button */
    .breadcrumb a {
        color: #b0b3b8;
        text-decoration: none;
        padding: 4px 10px;
        border-radius: 6px;
        transition: 0.2s;
    }

    /* HOVER kao sidebar */
    .breadcrumb a:hover {
        background: #2e323a;
        color: #ffffff;
    }

    /* SEPARATOR */
    .breadcrumb-separator {
        color: #555;
    }

    /* CURRENT PAGE */
    .breadcrumb span {
        background: #2e323a;
        color: #ffffff;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 500;
    }
</style>
```

</head>

<body>

```
<div class="sidebar">
    <h2>Vending App</h2>

    <a class="nav-link" href="/Dashboard">Dashboard</a>

    <!-- PRODUCTS -->
    <div class="nav-item">
        <a class="nav-link" asp-controller="Product" asp-action="Index">Products</a>

        <div class="flyout">
            @foreach (var p in products)
            {
                <a href="/products/info/@p.ProductId">
                        @p.Name
                    </a>
            }
        </div>
    </div>

    <!-- SUPPLIERS -->
    <div class="nav-item">
        <a class="nav-link" href="/Supplier">Suppliers</a>

        <div class="flyout">
            @foreach (var s in suppliers)
            {
                <a href="/Supplier/Details/@s.SupplierId">@s.Name</a>
            }
        </div>
    </div>

 <!-- VENDING MACHINES -->
   <div class="nav-item">
    <a class="nav-link" href="/VendingMachine">Machines</a>

    <div class="flyout">
        @foreach (var m in machines)
        {
            <a href="/VendingMachine/Details/@m.MachineId">Machine @m.MachineNumber</a>
        }
    </div>
</div>

<!-- ORDERS -->
    <div class="nav-item">
    <a class="nav-link" href="/Order">Orders</a>

    <div class="flyout">
        @foreach (var o in orders)
        {
            <a href="/Order/Details/@o.OrderId">Order #@o.OrderId</a>
        }
    </div>
</div>

<!-- MAINTENANCE LOGS -->
    <div class="nav-item">
    <a class="nav-link" href="/MaintenanceLog">Maintenance</a>

    <div class="flyout">
        @foreach (var l in logs)
        {
            <a href="/MaintenanceLog/Details/@l.MaintenanceLogId">
                @l.Status - @l.MaintenanceDate.ToShortDateString()
            </a>
        }
    </div>
</div>

<!-- TECHNICIANS -->
    <div class="nav-item">
    <a class="nav-link" href="/Technician">Technicians</a>

    <div class="flyout">
        @foreach (var t in technicians)
        {
            <a href="/Technician/Details/@t.TechnicianId">@t.Name</a>
        }
    </div>
</div>
</div>

<div class="content">
    @RenderBody()
</div>
```

</body>
</html>

