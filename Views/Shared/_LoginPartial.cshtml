@using Microsoft.AspNetCore.Identity
@using VendingMachineApp.Data.Entities
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div class="d-flex flex-row gap-3 align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <span class="text-white">
        Bok, 
        @if (User.IsInRole("Admin"))
    {
        <strong>Admin!</strong>
    }
    else if (User.IsInRole("Manager"))
{
    <strong>Manager!</strong>
}
else{
    <span>@User.Identity?.Name!</span>}
    
</span>
    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
        <button type="submit" class="btn btn-link text-white text-decoration-none p-0">Odjava</button>
    </form>
}
else
{
    <a class="text-white text-decoration-none" asp-area="Identity" asp-page="/Account/Register">Registracija</a>
    <a class="text-white text-decoration-none" asp-area="Identity" asp-page="/Account/Login">Prijava</a>
}
</div>



