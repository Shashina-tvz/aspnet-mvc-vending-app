@model DateTime?

@{
    var fieldName = ViewData["FieldName"]?.ToString();
}

<div class="datetime-wrapper">
    <input type="text"
           class="datetime-picker dark-input"
           value="@(Model.HasValue ? Model.Value.ToString("dd.MM.yyyy HH:mm") : "")"
           autocomplete="off" />

    <!-- hidden input koji se bind-a na model -->
    <input type="hidden"
           name="@fieldName"
           class="datetime-value"
           value="@(Model.HasValue ? Model.Value.ToString("O") : "")" />
</div>