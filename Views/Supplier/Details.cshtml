@model VendingMachineApp.Data.Entities.Supplier
@{
    ViewData["Title"] = "Supplier Details";
    Layout = "../Shared/_Layout.cshtml";
}

<style>
    .details-card {
        background: #23272f;
        color: #f3f3f3;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        padding: 2rem;
        max-width: 600px;
        margin: 2rem auto;
    }

    .header {
        border-bottom: 1px solid #3a3f47;
        padding-bottom: 1rem;
        margin-bottom: 1.5rem;
    }

    .supplier-name {
        font-size: 1.8rem;
        font-weight: 600;
    }

    .badge {
        display: inline-block;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        border-radius: 8px;
        background: #4fc3f7;
        color: #000;
    }

    .section {
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 0.95rem;
        color: #b0b3b8;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .item {
        margin-bottom: 0.4rem;
        font-size: 1.05rem;
    }

    .back-link {
        color: #4fc3f7;
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .email-row {
    display: flex;
    align-items: center;
    gap: 10px;
    }

    .email-link {
        color: #4fc3f7;
        text-decoration: none;
    }

    .copy-btn {
        background: #2e3440;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: 0.2s;
    }

    .copy-btn:hover {
        background: #4fc3f7;
        color: #000;
    }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <a href="/Dashboard">Home</a> 
        <span class="breadcrumb-separator">›</span>
        <a href="/Supplier">Suppliers</a> 
        <span class="breadcrumb-separator">›</span>
        <span>@Model.Name</span>
    </div>
</div>

<div class="details-card">

    <!-- HEADER -->
    <div class="header">
        <div class="supplier-name">@Model.Name</div>
        <div class="badge">Supplier</div>
    </div>

    <!-- CONTACT -->
    <div class="section">
        <div class="section-title">Contact</div>
        <div class="item">👤 @Model.ContactPerson</div>
       <div class="item email-row">
            <span>📧</span>

            <a href="mailto:@Model.Email" class="email-link">
                @Model.Email
            </a>

            <button class="copy-btn" onclick="copyEmail('@Model.Email', this)">
                Copy
            </button>
        </div>
        <div class="item">📞 @Model.PhoneNumber</div>
    </div>

    <!-- LOCATION -->
    <div class="section">
        <div class="section-title">Address</div>
        <div class="item">📍 @Model.Address</div>
    </div>

    <!-- META -->
    <div class="section">
        <div class="section-title">Details</div>
        <div class="item">📅 Partner since: @Model.RegistrationDate.ToShortDateString()</div>
    </div>

    <a class="back-link" href="/Supplier/Index">← Back to Suppliers</a>
</div>

<script>
    function copyEmail(email, btn) {
        navigator.clipboard.writeText(email);
        btn.innerText = "Copied!";
        
        setTimeout(() => {
            btn.innerText = "Copy";
        }, 1500);
    }
</script>