@model IEnumerable<VendingMachineApp.Data.Entities.Supplier>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "../Shared/_Layout.cshtml";
    var highlightId = Context.Request.Query["highlightId"].ToString();
}



<div class="breadcrumb-container">
    <div class="breadcrumb">
        <a href="/Dashboard">Home</a>
        <span class="breadcrumb-separator">›</span>
        <span>Suppliers</span>
    </div>
</div>

<div class="page-header">
    <div class="header-left">
        <h1>Suppliers</h1>
        <p class="subtitle">Manage supplier information and contacts</p>
    </div>

    <div class="header-actions">
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a href="/Supplier/Create" class="btn-icon add">
                <i class="fa-solid fa-plus"></i>
            </a>
        }
    </div>
</div>

<div class="table-container">

    <div class="toolbar">
        <input type="text"
               id="searchBox"
               class="search-input"
               placeholder="Search suppliers, address, email..." />
    </div>

    <div id="supplierTable">
        @await Html.PartialAsync("_SupplierTable", Model)
    </div>

</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchBox = document.getElementById("searchBox");
        const tableDiv = document.getElementById("supplierTable");

        let timeout = null;

        searchBox.addEventListener("keyup", function () {

            clearTimeout(timeout);

            timeout = setTimeout(() => {

                const term = searchBox.value;

                fetch(`/Supplier/Search?term=${encodeURIComponent(term)}`)
                    .then(r => r.text())
                    .then(html => {
                        tableDiv.style.opacity = 0.5;
                        tableDiv.innerHTML = html;
                        tableDiv.style.opacity = 1;
                    })
                    .catch(err => console.error("Search error:", err));

            }, 300);

        });

        const id = "@highlightId";

if (id) {
    const row = document.getElementById("supplier-" + id);

    if (row) {
        row.classList.add("flash-row");

        row.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
        setTimeout(() => {
    row.classList.remove("flash-row");
}, 1200);
    }
}

    });
</script>
}