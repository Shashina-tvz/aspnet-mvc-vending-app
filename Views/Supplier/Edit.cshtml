@model VendingMachineApp.Data.Entities.Supplier
@{
    ViewData["Title"] = "Edit Supplier";
    Layout = "../Shared/_Layout.cshtml";
}
<div class="form-card">
    <div class="form-content">
        <h2>Edit Supplier</h2>
        <form asp-action="Edit" method="post" autocomplete="off">
            <input type="hidden" asp-for="SupplierId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="tab-header">
                <button type="button" class="tab-btn active" data-tab="basic">Basic Info</button>
                <button type="button" class="tab-btn" data-tab="contact">Contact</button>
                <button type="button" class="tab-btn" data-tab="address">Address</button>
                <button type="button" class="tab-btn" data-tab="dates">Dates</button>
            </div>
            <div class="tab-section show" id="tab-basic">
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="Name" class="section-header"></label>
                        <input asp-for="Name" class="dark-input @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "input-validation-error" : "")" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="tab-section" id="tab-contact">
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="ContactPerson" class="section-header"></label>
                        <input asp-for="ContactPerson" class="dark-input @(ViewData.ModelState["ContactPerson"]?.Errors.Count > 0 ? "input-validation-error" : "")" />
                        <span asp-validation-for="ContactPerson" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="PhoneNumber" class="section-header"></label>
                        <input asp-for="PhoneNumber" class="dark-input @(ViewData.ModelState["PhoneNumber"]?.Errors.Count > 0 ? "input-validation-error" : "")" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Email" class="section-header"></label>
                        <input asp-for="Email" class="dark-input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-validation-error" : "")" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="tab-section" id="tab-address">
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="Address" class="section-header"></label>
                        <input asp-for="Address" class="dark-input @(ViewData.ModelState["Address"]?.Errors.Count > 0 ? "input-validation-error" : "")" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="tab-section" id="tab-dates">
                <div class="form-row">
                    <div class="form-field">
                        <label asp-for="RegistrationDate" class="section-header"></label>
                         <date-time asp-for="RegistrationDate" ></date-time>
                        <span asp-validation-for="RegistrationDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-row form-actions">
                <button type="submit" class="btn-custom primary">Save Changes</button>
                <a asp-action="Index" class="btn-custom secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
<style>
    .form-card { background: #23272f; border-radius: 18px; box-shadow: 0 4px 24px #000a; margin: 2.5rem auto; max-width: 800px; padding: 2.5rem 2.5rem 2rem 2.5rem; }
    .tab-header { display: flex; gap: 1.5rem; margin-bottom: 2rem; }
    .tab-btn { background: none; border: none; color: #9ca3af; font-size: 1.08rem; padding: 0.7rem 1.5rem; border-radius: 8px 8px 0 0; cursor: pointer; transition: background 0.2s, color 0.2s; }
    .tab-btn.active { color: #4fc3f7; background: #181a20; font-weight: 600; }
    .tab-section { display: none; }
    .tab-section.show { display: block; }
    .form-row { display: flex; gap: 2.5rem; margin-bottom: 2.2rem; flex-wrap: wrap; }
    .form-field { flex: 1 1 220px; display: flex; flex-direction: column; gap: 0.5rem; position: relative;}
    .dark-input, select.dark-input, textarea.dark-input { background: #181a20; color: #f3f3f3; border: 1px solid #2e323a; border-radius: 10px; font-size: 1.08rem; padding: 0.7rem 1rem; }
    .dark-input.input-validation-error { border: 2px solid #dc3545 !important;}
    .dark-input:focus { border-color: #4fc3f7; }
    .section-header { color: #9ca3af; font-size: 1.08rem; font-weight: 500; }
    .form-actions { justify-content: flex-end; gap: 1.2rem; }
    .btn-custom { padding: 0.7rem 2.2rem; border-radius: 8px; font-size: 1.08rem; font-weight: 600; border: none; cursor: pointer; transition: background 0.2s, color 0.2s; text-decoration: none; display: inline-block; }
    .btn-custom.primary { background: #2563eb; color: #fff; }
    .btn-custom.primary:hover { background: #1d4ed8; }
    .btn-custom.secondary { background: #374151; color: #fff; }
    .btn-custom.secondary:hover { background: #4b5563; }
    .text-danger { color: #ff4d4d; font-size: 0.9rem; margin-top: 4px; display: block;}
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabSections = document.querySelectorAll('.tab-section');
        tabBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                tabBtns.forEach(b => b.classList.remove('active'));
                tabSections.forEach(s => s.classList.remove('show'));
                btn.classList.add('active');
                document.getElementById('tab-' + btn.dataset.tab).classList.add('show');
            });
        });
    });
</script>
