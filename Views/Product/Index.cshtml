@model IEnumerable<VendingMachineApp.Data.Entities.Product>
    

@{
    ViewData["Title"] = "Products";
    Layout = "_Layout";
    var highlightId = Context.Request.Query["highlightId"].ToString();
}



<div class="breadcrumb-container">
    <div class="breadcrumb">
        <a href="/Dashboard">Home</a>
        <span class="breadcrumb-separator">›</span>
        <span>Products</span>
    </div>
</div>

<div class="page-header">
    <div class="header-left">
        <h1>Products</h1>
        <p class="subtitle">Manage inventory, pricing and suppliers</p>
    </div>

    <div class="header-actions">
         @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a href="/products/new" class="btn-icon add">
                <i class="fa-solid fa-plus"></i>
            </a>
        }
    </div>
</div>



<div class="table-container">

    <div class="toolbar">
    <input type="text"
           id="searchBox"
           class="search-input"
           placeholder="Search products, categories, suppliers..." />
    </div>

    <div id="productTable">

    @await Html.PartialAsync("_ProductTable", Model)

    </div>

</div>



<!--JavaScript za live search (fetchuje samo tabelu sa rezultatima, ne reloaduje celu stranicu) -->
@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchBox = document.getElementById("searchBox");
        const tableDiv = document.getElementById("productTable");

        let timeout = null;

        searchBox.addEventListener("keyup", function () {     //svaki pritisak na tastaturi

            clearTimeout(timeout);

            timeout = setTimeout(() => {

                const term = searchBox.value;

                fetch(`/Product/Search?term=${encodeURIComponent(term)}`)   //zove controller koji vraća samo partial view sa filtriranim proizvodima
                    .then(response => response.text())                     //dobije HTML iz _ProductTable
                                   
                    .then(html => {
                        tableDiv.style.opacity = 0.5;
                        tableDiv.innerHTML = html;
                        tableDiv.style.opacity = 1;                           //innerHTML zamenjuje ceo sadržaj div-a sa novim HTML-om koji sadrži samo filtrirane proizvode
                    })
                    .catch(err => console.error("Search error:", err));

            }, 300);                                             // setTimeout (300) debounce (da ne šalje request na svako slovo odmah)

        });

        // =========================
// HIGHLIGHT AFTER REDIRECT
// =========================
const id = "@highlightId";

if (id) {
    const row = document.getElementById("product-" + id);

     if (row) {
        row.classList.add("flash-row");

        row.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        setTimeout(() => {
            row.classList.remove("flash-row");
        }, 1200);
    }
}

    });
</script>
}