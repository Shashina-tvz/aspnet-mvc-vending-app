@model VendingMachineApp.Data.Entities.Product
@{
    ViewData["Title"] = "Product Details";
    Layout = "../Shared/_Layout.cshtml";

    var today = DateTime.Now;
    var status = "Fresh";

    if (Model.ExpirationDate < today)
    {
        status = "Expired";
    }
    else if (Model.ExpirationDate < today.AddDays(7))
    {
        status = "Expiring soon";
    }
}

<style>
    .details-panel {
        background: #23272f;
        color: #f3f3f3;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.10);
        padding: 2.5rem;
        max-width: 540px;
        margin: 2rem auto;
    }

    .details-section {
        margin-bottom: 1.5rem;
    }

    .details-label {
        color: #b0b3b8;
        font-size: 0.98rem;
        margin-bottom: 0.2rem;
    }

    .details-value {
        font-size: 1.1rem;
        font-weight: 500;
        margin-bottom: 0.7rem;
    }

    .product-name {
        font-size: 1.8rem;
        font-weight: 600;
    }

    .back-link {
        color: #4fc3f7;
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .badge {
        display: inline-block;
        margin-top: 0.3rem;
        font-size: 0.8rem;
        padding: 0.2rem 0.6rem;
        border-radius: 8px;
        background: #4fc3f7;
        color: #000;
    }

    /* STATUS */
    .status {
        display: inline-block;
        margin-top: 0.5rem;
        margin-bottom: 1.5rem;
        padding: 0.25rem 0.7rem;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .fresh { background: #4caf50; }
    .expiring { background: #ff9800; }
    .expired { background: #f44336; }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <a href="/Dashboard">Home</a>
        <span class="breadcrumb-separator">›</span>
        <a href="/Product">Products</a>
        <span class="breadcrumb-separator">›</span>
        <span>@Model.Name</span>
    </div>
</div>

<div class="details-panel">

     <!-- HEADER -->
    <div class="header">
        <div class="product-name">@Model.Name</div>
        <div class="badge">Product</div>
    </div>

    <!-- STATUS -->
    <span class="status @(status == "Fresh" ? "fresh" : status == "Expiring soon" ? "expiring" : "expired")">
        @status
    </span>

    <div class="details-section">
        <div class="details-label">Category</div>
        <div class="details-value">@Model.Category</div>
    </div>

    <div class="details-section">
        <div class="details-label">Supplier ID</div>
        <div class="details-value">@Model.SupplierId</div>
    </div>

    <div class="details-section">
        <div class="details-label">Description</div>
        <div class="details-value">@Model.Description</div>
    </div>

    <div class="details-section">
        <div class="details-label">Manufacture Date</div>
        <div class="details-value">@Model.ManufactureDate.ToShortDateString()</div>
    </div>

    <div class="details-section">
        <div class="details-label">Expiration Date</div>
        <div class="details-value">@Model.ExpirationDate.ToShortDateString()</div>
    </div>

    <div class="details-section">
        <div class="details-label">Reorder Threshold</div>
        <div class="details-value">@Model.ReorderThreshold</div>
    </div>

    <a class="back-link" href="/Product/Index">&#8592; Back to List</a>

</div>